# Frontend environment variables
# Required: URL of the chatbot backend (FastAPI)
# Example for local development:
REACT_APP_BACKEND_URL=http://localhost:8000

# SECURITY NOTE:
# Do NOT put your OpenAI API key in the frontend. The frontend code runs in the browser and is visible to users.
# The backend handles all OpenAI access and requires OPENAI_API_KEY in its own environment.
# REACT_APP_OPENAI_API_KEY is intentionally NOT used here to avoid exposing secrets.
